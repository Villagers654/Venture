{
  "version": 6,
  "configurePresets": [
    {
      "name": "windows-base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "environment": {
        "PATH": "${sourceDir}/.deps/llvm-mingw/bin;${sourceDir}/.deps/ninja;${sourceDir}/.deps/cmake/bin;$penv{PATH}"
      },
      "cacheVariables": {
        "CMAKE_C_COMPILER": "${sourceDir}/.deps/llvm-mingw/bin/clang.exe",
        "CMAKE_CXX_COMPILER": "${sourceDir}/.deps/llvm-mingw/bin/clang++.exe",
        "CMAKE_RC_COMPILER": "${sourceDir}/.deps/llvm-mingw/bin/llvm-rc.exe",
        "CMAKE_MAKE_PROGRAM": "${sourceDir}/.deps/ninja/ninja.exe",
        "CMAKE_PROJECT_TOP_LEVEL_INCLUDES": "${sourceDir}/cmake/FetchCache.cmake",
        "VENTURE_FETCH_CACHE_DIR": "${sourceDir}/.deps/fetch",
        "VENTURE_PROBE_CACHE": "ON",
        "FETCHCONTENT_UPDATES_DISCONNECTED": "ON"
      },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    },
    {
      "name": "windows-debug",
      "inherits": "windows-base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "windows-release",
      "inherits": "windows-base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "RelWithDebInfo" }
    },
    {
      "name": "linux-release",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_PROJECT_TOP_LEVEL_INCLUDES": "${sourceDir}/cmake/FetchCache.cmake",
        "VENTURE_FETCH_CACHE_DIR": "${sourceDir}/.deps/fetch",
        "VENTURE_PROBE_CACHE": "ON",
        "FETCHCONTENT_UPDATES_DISCONNECTED": "ON"
      },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" }
    },
    {
      "name": "linux-baseline",
      "displayName": "Linux release baseline (run inside tools/linux-baseline, glibc 2.35)",
      "inherits": "linux-release",
      "toolchainFile": "${sourceDir}/cmake/toolchains/linux-baseline.cmake",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_C_FLAGS_RELWITHDEBINFO": "-O2 -DNDEBUG",
        "CMAKE_CXX_FLAGS_RELWITHDEBINFO": "-O2 -DNDEBUG",
        "VENTURE_BUILD_TESTS": "OFF"
      }
    },
    {
      "name": "windows-agent", "inherits": "windows-release",
      "cacheVariables": { "VENTURE_AGENT_CACHE": "ON" }
    },
    {
      "name": "linux-agent", "inherits": "linux-release",
      "cacheVariables": { "VENTURE_AGENT_CACHE": "ON" }
    },
    {
      "name": "linux-arm64-cross-base",
      "hidden": true,
      "displayName": "Linux arm64 (Steam Frame), cross-built with the pinned sysroot (tools/linux_arm64/sysroot.py)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "toolchainFile": "${sourceDir}/cmake/toolchains/linux-arm64.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_PROJECT_TOP_LEVEL_INCLUDES": "${sourceDir}/cmake/FetchCache.cmake",
        "VENTURE_FETCH_CACHE_DIR": "${sourceDir}/.deps/fetch",
        "VENTURE_PROBE_CACHE": "ON",
        "FETCHCONTENT_UPDATES_DISCONNECTED": "ON"
      }
    },
    {
      "name": "windows-linux-arm64", "inherits": "linux-arm64-cross-base",
      "environment": { "PATH": "${sourceDir}/.deps/llvm-mingw/bin;${sourceDir}/.deps/ninja;${sourceDir}/.deps/cmake/bin;$penv{PATH}" },
      "cacheVariables": { "CMAKE_MAKE_PROGRAM": "${sourceDir}/.deps/ninja/ninja.exe", "VENTURE_AGENT_CACHE": "ON" },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    },
    {
      "name": "linux-linux-arm64", "inherits": "linux-arm64-cross-base",
      "cacheVariables": { "VENTURE_AGENT_CACHE": "ON" },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" }
    },
    {
      "name": "android-arm64-base",
      "hidden": true,
      "displayName": "Android arm64: the one Venture APK (pinned NDK r30, Android build tools)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "toolchainFile": "${sourceDir}/cmake/toolchains/android-arm64.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_PROJECT_TOP_LEVEL_INCLUDES": "${sourceDir}/cmake/FetchCache.cmake",
        "VENTURE_FETCH_CACHE_DIR": "${sourceDir}/.deps/fetch",
        "FETCHCONTENT_UPDATES_DISCONNECTED": "ON",
        "VENTURE_BUILD_LAUNCHER": "ON",
        "VENTURE_BUILD_RUNTIME": "OFF",
        "VENTURE_BUILD_TESTS": "OFF"
      }
    },
    {
      "name": "windows-android-arm64", "inherits": "android-arm64-base",
      "cacheVariables": { "CMAKE_MAKE_PROGRAM": "${sourceDir}/.deps/ninja/ninja.exe" },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    },
    {
      "name": "linux-android-arm64", "inherits": "android-arm64-base",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" }
    }
  ],
  "buildPresets": [
    { "name": "windows-debug", "configurePreset": "windows-debug" },
    { "name": "windows-release", "configurePreset": "windows-release" },
    { "name": "linux-release", "configurePreset": "linux-release" },
    { "name": "linux-baseline", "configurePreset": "linux-baseline" },
    { "name": "windows-agent", "configurePreset": "windows-agent" },
    { "name": "linux-agent", "configurePreset": "linux-agent" },
    { "name": "windows-linux-arm64", "configurePreset": "windows-linux-arm64" },
    { "name": "linux-linux-arm64", "configurePreset": "linux-linux-arm64" },
    { "name": "windows-android-arm64", "configurePreset": "windows-android-arm64" },
    { "name": "linux-android-arm64", "configurePreset": "linux-android-arm64" }
  ],
  "testPresets": [
    { "name": "windows-release", "configurePreset": "windows-release", "output": { "outputOnFailure": true } },
    { "name": "linux-release", "configurePreset": "linux-release", "output": { "outputOnFailure": true } }
  ]
}
