+    // An entirely transient (depth/stencil multisampled-render-to-texture) target whose
+    // multisampled image has real memory keeps its contents in that image across render passes:
+    // storeOp=STORE, and loadOp=LOAD while the image holds defined contents.  No resolve or
+    // unresolve attachment is added, so a render pass that is cleared or invalidated costs
+    // nothing extra and a render pass break costs a load.  Images backed by lazily allocated
+    // memory keep discarding their contents.
+    bool keepsMultisampledContent() const
+    {
+        return isEntirelyTransient() &&
+               (mImage->getUsage() & VK_IMAGE_USAGE_TRANSIENT_ATTACHMENT_BIT) == 0;
+    }
