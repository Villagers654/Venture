#: src/launcher/import.cpp:51 src/launcher/import.cpp:101
msgid "Android platform-tools (adb) were not found. Install them, or set adb's location in Settings."
msgstr "Android platform-tools(adb)를 찾을 수 없습니다. 설치하거나 설정에서 adb 위치를 지정하세요."

#: src/launcher/import.cpp:52
msgid "adb was not found at the location set in Settings."
msgstr "설정에서 지정한 위치에 adb를 찾을 수 없습니다."

#: src/launcher/import.cpp:66
msgid "No games are installed on this headset."
msgstr "이 헤드셋에 설치된 게임이 없습니다."

#: src/launcher/import.cpp:169
msgid "A newer version is installed"
msgstr "더 새로운 버전이 설치되어 있습니다"

#: src/launcher/import.cpp:172
msgid "Updates the installed version"
msgstr "설치된 버전을 업데이트합니다"

#: src/launcher/import.cpp:172
msgid "Completes the installation"
msgstr "설치를 완료합니다"

#: src/launcher/import.cpp:174
msgid "Ready to import"
msgstr "가져오기 준비 완료"

#: src/launcher/import.cpp:203
msgid "Choose an absolute folder to import to."
msgstr "가져올 절대 경로 폴더를 선택하세요."

#: src/launcher/import.cpp:220
msgid "Select a game to import."
msgstr "가져올 게임을 선택하세요."

#: src/launcher/platform/posix/auth_browser.cpp:297 src/launcher/platform/posix/auth_browser.cpp:394
msgid "Sign in to Meta - Venture"
msgstr "Meta에 로그인 - Venture"

#: src/launcher/platform/posix/auth_browser.cpp:472
msgid "Meta sign-in needs WebKitGTK. Install webkitgtk-6.0 (or webkit2gtk-4.1) from your distribution."
msgstr "Meta 로그인에는 WebKitGTK가 필요합니다. 배포판에서 webkitgtk-6.0(또는 webkit2gtk-4.1)을 설치하세요."

#: src/launcher/platform/posix/auth_browser.cpp:474
msgid "This WebKitGTK is too old to keep the sign-in window on Meta's pages. Update webkitgtk-6.0 (or webkit2gtk-4.1)."
msgstr "이 WebKitGTK는 Meta 페이지에 로그인 창을 유지하기에는 너무 오래되었습니다. webkitgtk-6.0(또는 webkit2gtk-4.1)을 업데이트하세요."

#: src/launcher/platform/posix/auth_browser.cpp:476
msgid "The Meta sign-in page stopped unexpectedly. Try again."
msgstr "Meta 로그인 페이지가 예상치 않게 중단되었습니다. 다시 시도하세요."

#: src/launcher/platform/posix/auth_browser.cpp:477 src/launcher/platform/posix/auth_browser.cpp:490 src/launcher/platform/posix/auth_browser.cpp:494 src/launcher/platform/posix/auth_browser.cpp:514
msgid "Could not open the Meta sign-in window."
msgstr "Meta 로그인 창을 열 수 없습니다."

#: src/launcher/platform/posix/auth_browser.cpp:483
msgid "Sign-in URL is outside allowed Meta domains."
msgstr "로그인 URL이 허용된 Meta 도메인 밖에 있습니다."

#: src/launcher/platform/posix/auth_browser.cpp:560
#, python-brace-format
msgid "The Meta sign-in window stopped with {0}."
msgstr "Meta 로그인 창이 {0}으로 중단되었습니다."

#: src/launcher/platform/posix/window_style.cpp:24
msgid "The Venture launcher needs a Wayland session, and no Wayland display was reachable (check WAYLAND_DISPLAY and XDG_RUNTIME_DIR)."
msgstr "Venture 런처에는 Wayland 세션이 필요하지만 도달 가능한 Wayland 디스플레이가 없습니다(WAYLAND_DISPLAY와 XDG_RUNTIME_DIR을 확인하세요)."

#: src/launcher/platform/win32/auth_browser.cpp:83
msgid "Could not open Meta sign-in. Install or repair the Microsoft Edge WebView2 Runtime."
msgstr "Meta 로그인을 열 수 없습니다. Microsoft Edge WebView2 런타임을 설치하거나 수리하세요."

#: src/launcher/platform/win32/auth_browser.cpp:375
msgid "Could not initialize the Windows sign-in window."
msgstr "Windows 로그인 창을 초기화할 수 없습니다."

#: src/launcher/platform/win32/auth_browser.cpp:398
msgid "Could not create the sign-in window."
msgstr "로그인 창을 생성할 수 없습니다."

#: src/launcher/platform/win32/window_style.cpp:35
msgid "Could not initialize SDL video."
msgstr "SDL 비디오를 초기화할 수 없습니다."

#: src/launcher/ui/views.cpp:1715
msgid "Meta store"
msgstr "Meta 스토어"

