# Fail during configure before dependency downloads or target construction.
# The host's verified build is .deps/ffmpeg; a Linux arm64 cross build uses
# its own (tools/ffmpeg/build_ffmpeg.py --target linux-arm64).
if(CMAKE_CROSSCOMPILING AND CMAKE_SYSTEM_NAME STREQUAL "Linux" AND CMAKE_SYSTEM_PROCESSOR MATCHES "aarch64|arm64")
  set(VENTURE_FFMPEG_BASE "${PROJECT_SOURCE_DIR}/.deps/ffmpeg-linux-arm64")
  set(venture_ffmpeg_provision "py -3 tools/ffmpeg/build_ffmpeg.py --target linux-arm64")
else()
  set(VENTURE_FFMPEG_BASE "${PROJECT_SOURCE_DIR}/.deps/ffmpeg")
  set(venture_ffmpeg_provision "python tools/bootstrap.py")
endif()
if(WIN32)
  set(venture_ffmpeg_default "${VENTURE_FFMPEG_BASE}/install")
else()
  set(venture_ffmpeg_default "${VENTURE_FFMPEG_BASE}/install-posix")
endif()
set(VENTURE_FFMPEG_ROOT "${venture_ffmpeg_default}" CACHE PATH "Verified LGPL FFmpeg build")
if(WIN32)
  set(venture_ffmpeg_components bin/avutil-60.dll bin/avcodec-62.dll bin/avformat-62.dll bin/swscale-9.dll)
else()
  set(venture_ffmpeg_components lib/libavutil.so.60 lib/libavcodec.so.62 lib/libavformat.so.62 lib/libswscale.so.9)
endif()
foreach(component IN ITEMS ${venture_ffmpeg_components} venture-ffmpeg.json
    include/libavcodec/avcodec.h include/libavformat/avformat.h include/libavutil/avutil.h)
  if(NOT EXISTS "${VENTURE_FFMPEG_ROOT}/${component}")
    message(FATAL_ERROR "Missing verified FFmpeg dependency (${component}). Run ${venture_ffmpeg_provision} from the worktree root, then configure again.")
  endif()
endforeach()
foreach(component IN ITEMS archive/ffmpeg-8.1.3.tar.xz signature/release.asc)
  if(NOT EXISTS "${VENTURE_FFMPEG_BASE}/${component}")
    message(FATAL_ERROR "Missing FFmpeg source/license bundle (${component}). Run ${venture_ffmpeg_provision} from the worktree root, then configure again.")
  endif()
endforeach()
