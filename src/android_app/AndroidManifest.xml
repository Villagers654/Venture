<?xml version="1.0" encoding="utf-8"?>
<!-- SPDX-License-Identifier: GPL-3.0-or-later
     The one Venture APK for every Android headset (docs/design/native-headsets.md,
     section 5). A 2D panel app: no VR launch categories. Version and SDK levels
     come from the build (tools/android/build_apk.py). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.venture_emu.venture"
    android:installLocation="internalOnly">

    <uses-feature android:glEsVersion="0x00030000" android:required="true" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.hardware.gamepad" android:required="false" />
    <uses-feature android:name="android.hardware.bluetooth" android:required="false" />
    <uses-feature android:name="android.hardware.usb.host" android:required="false" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Adapted games are installed through the system PackageInstaller; the
         user confirms each install. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <!-- A game reads its expansion files from Android/obb/<its package>.
         Android 11 and later let an app the user allows to install apps
         (REQUEST_INSTALL_PACKAGES) write there. Android 10 needs the storage
         permission, asked for when the first expansion file is placed, with
         legacy storage (requestLegacyExternalStorage, which only Android 10
         reads). Everything else Venture keeps (games, downloads, caches,
         logs) is in its app-specific storage, which needs no permission. -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="29" />
    <!-- The headset check reads the launch markers that the device's own VR
         apps share, and the plan checks which games are installed. -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- The headset check asks the OpenXR runtime for its version and
         extensions through the Khronos loader, which finds the runtime
         through its broker. -->
    <uses-permission android:name="org.khronos.openxr.permission.OPENXR" />
    <uses-permission android:name="org.khronos.openxr.permission.OPENXR_SYSTEM" />
    <queries>
        <provider android:authorities="org.khronos.openxr.runtime_broker;org.khronos.openxr.system_runtime_broker" />
    </queries>

    <application
        android:label="@string/app_name"
        android:icon="@drawable/ic_launcher"
        android:allowBackup="false"
        android:requestLegacyExternalStorage="true"
        android:extractNativeLibs="false"
        android:hardwareAccelerated="true"
        android:resizeableActivity="true"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar">

        <activity android:name=".VentureActivity"
            android:label="@string/app_name"
            android:exported="true"
            android:launchMode="singleTask"
            android:alwaysRetainTaskState="true"
            android:configChanges="layoutDirection|locale|fontScale|orientation|uiMode|screenLayout|screenSize|smallestScreenSize|keyboard|keyboardHidden|navigation|density">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Meta's sign-in address from the device's browser (manual sign-in). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="oculus" />
                <data android:scheme="oculus-client" />
            </intent-filter>
        </activity>

        <activity android:name=".SignInActivity"
            android:label="@string/sign_in_title"
            android:exported="false"
            android:configChanges="orientation|screenLayout|screenSize|smallestScreenSize|keyboard|keyboardHidden|navigation|density" />

        <!-- The Meta Platform broker for the games Venture installed. Exported
             so they can bind it; every call checks that the caller is one of
             them, signed with the user's game key (PlatformService). -->
        <service android:name=".PlatformService"
            android:exported="true" />
    </application>
</manifest>
